# ── Sunucu ────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Veritabanı ────────────────────────────────────────────
DATABASE_URL=postgresql://KULLANICI:GUCLU_SIFRE@localhost:5432/edunova

# ── Kimlik doğrulama ──────────────────────────────────────
# En az 32 karakter olmalı; yer tutucu değerle sunucu AÇILMAZ.
# Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ── CORS ──────────────────────────────────────────────────
# Üretimde ZORUNLU. Virgülle ayrılmış tam origin listesi.
CORS_ORIGINS=

# Reverse proxy arkasında: 1
TRUST_PROXY=loopback
